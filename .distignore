# .distignore — files NOT shipped to WP.org SVN.
# Per CONTEXT.md BOOT-07 + CLAUDE.md §"Architecture".

# Dev tooling configs
/.editorconfig
/.gitignore
/.gitattributes
/.distignore
/.dockerignore
/phpunit.xml.dist
/phpunit.xml
/phpcs.xml.dist
/phpcs.xml
/phpstan.neon.dist
/phpstan.neon
/phpstan-baseline.neon
/.phpcs-cache

# Composer source (only vendor/ ships)
/composer.json
/composer.lock

# Repo-only directories
/tests/
/bin/
/.github/
/.githooks/
/.ddev/
/.planning/
/.claude/
/docs/
/build/
/release/
/stubs/
/node_modules/

# Markdown — only readme.txt ships; everything else stays in repo
*.md
!readme.txt

# Editor / OS detritus
.DS_Store
Thumbs.db
*.swp
*.swo

# Caches
.phpunit.result.cache
.phpcs-cache
