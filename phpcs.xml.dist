<?xml version="1.0"?>
<ruleset name="better-rest-api-logs">
    <description>WPCS 3.3 for Better REST API Logs (PHP 7.4 floor, WP 6.6 floor).</description>

    <!-- What to scan -->
    <file>better-rest-api-logs.php</file>
    <file>uninstall.php</file>
    <file>includes</file>
    <file>tests</file>

    <!-- What not to scan -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>tests/_data/*</exclude-pattern>
    <exclude-pattern>.planning/*</exclude-pattern>
    <exclude-pattern>.claude/*</exclude-pattern>
    <exclude-pattern>.ddev/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>
    <exclude-pattern>release/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="cache" value=".phpcs-cache"/>

    <!-- PHP and WP version ranges -->
    <config name="testVersion" value="7.4-"/>
    <config name="minimum_wp_version" value="6.6"/>

    <!-- Main WPCS standard -->
    <rule ref="WordPress">
        <!-- Yoda conditions are not enforced — modern style preferred -->
        <exclude name="WordPress.PHP.YodaConditions.NotYoda"/>
        <!-- We use Composer autoloading, not manual require chains -->
        <exclude name="WordPress.WP.AlternativeFunctions.file_system_read_file_get_contents"/>
        <!-- Modern array syntax is required -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <!-- Kebab-case slug filenames + PascalCase class names: WPCS-sanctioned opt-out.
         See ARCHITECTURE.md §"PHPCS adjustment" + CLAUDE.md §"PHPCS". -->
    <rule ref="WordPress.Files.FileName">
        <properties>
            <property name="strict_class_file_names" value="false"/>
        </properties>
    </rule>

    <!-- PHP compatibility for our range -->
    <rule ref="PHPCompatibilityWP"/>

    <!-- Text-domain enforcement -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="better-rest-api-logs"/>
        </properties>
    </rule>

    <!-- Prefix enforcement: hook brl_*, constant BRL_*, namespace BetterRestApiLogs -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array" value="brl_,BRL_,BetterRestApiLogs"/>
        </properties>
    </rule>

    <!-- Test files: relax some rules that don't apply (e.g., direct DB access in fixtures) -->
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
