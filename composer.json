{
    "name": "unaibamir/better-rest-api-logs",
    "description": "Reliable, accurate, queryable REST API request/response logs for WordPress, with no wp_posts bloat.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/unaibamir/better-rest-api-logs",
    "authors": [
        {
            "name": "Unaib Amir",
            "email": "unaibamiraziz@gmail.com",
            "homepage": "https://unaibamir.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "composer-runtime-api": "^2.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/wordpress-stubs": "^6.9 || ^7.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.3",
        "wp-phpunit/wp-phpunit": "^6.4 || ^7.0",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "classmap": ["includes/"]
    },
    "autoload-dev": {
        "psr-4": {
            "BetterRestApiLogs\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcs:fix": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1024M",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "test:coverage": "phpunit --coverage-html=build/coverage",
        "hooks:gen": "php bin/generate-hooks-doc.php",
        "pot": "wp i18n make-pot . languages/better-rest-api-logs.pot --slug=better-rest-api-logs --domain=better-rest-api-logs --exclude=tests,bin,.ddev,.planning,.githooks,.wordpress-org,docs --headers='{\"POT-Creation-Date\":\"\"}'",
        "banlist": "bin/check-banlist.sh",
        "check:table-naming": "bin/check-table-naming.sh",
        "check:settings-isolation": "bin/check-settings-isolation.sh",
        "check:no-external-calls": "bin/check-no-external-calls.sh",
        "check:asset-enqueue": "bash bin/check-asset-enqueue.sh",
        "check:hooks": "bin/check-hooks-documented.sh",
        "check:pot": "bin/check-pot.sh",
        "test:unit:coverage-check": "bin/check-coverage.sh 80",
        "coverage": "bin/check-coverage.sh 80",
        "ci": [
            "@phpcs",
            "@phpstan",
            "@banlist",
            "@check:table-naming",
            "@check:settings-isolation",
            "@check:no-external-calls",
            "@check:hooks",
            "@test",
            "@test:unit:coverage-check"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
